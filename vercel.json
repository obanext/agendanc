{
  "redirects": [
    { "source": "/landscape/:slug.htm", "destination": "/landscape/:slug", "permanent": true },
    { "source": "/landscape/:slug.html", "destination": "/landscape/:slug", "permanent": true },
    { "source": "/portrait/:slug.htm", "destination": "/portrait/:slug", "permanent": true },
    { "source": "/portrait/:slug.html", "destination": "/portrait/:slug", "permanent": true }
  ],
  "headers": [
    {
      "source": "/landscape/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=7200, immutable" }
      ]
    },
    {
      "source": "/portrait/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=7200, immutable" }
      ]
    }
  ]
}
